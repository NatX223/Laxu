PORT=3000
LOG_LEVEL=info

# From your hosted Postgres (Neon/Supabase) -- see the README for setup steps
DATABASE_URL=

# --- Chain -------------------------------------------------------------------
# Must support WebSocket subscriptions (wss://) for the indexer's live
# watchContractEvent phase; ws/wss also gets used for the shared read client.
RPC_URL=
CHAIN_ID=
POSITION_TOKEN_FACTORY_ADDRESS=
# Backfill start point for the indexer when no checkpoint row exists yet.
POSITION_TOKEN_FACTORY_DEPLOY_BLOCK=
# Arcus testnet USDG (6 decimals, open mint). Must match the token the
# PositionToken implementation was deployed against.
USDG_ADDRESS=0x293b337712d4312776a3a2d292f44410e7873bad

# The one backend key for every Laxu contract write: createPosition,
# createPool, applyReport, fulfil*, close. PositionTokenFactory passes its
# `deployer` through as each token's `arcusOperator`, so this key's address must
# be the Factory's `deployer`. Never committed.
OPERATOR_PRIVATE_KEY=

# The open-position flow creates each position's LendingPool straight after
# minting its token, so this is required whenever orchestration runs.
# LIQUIDATOR_PRIVATE_KEY holds NONE of the operator's roles -- liquidate() is
# permissionless, so it only ever needs a USDG balance and pool approvals.
LENDING_POOL_FACTORY_ADDRESS=
LENDING_POOL_FACTORY_DEPLOY_BLOCK=
LIQUIDATOR_PRIVATE_KEY=

# --- Arcus -------------------------------------------------------------------
ARCUS_API_BASE_URL=https://api.testnet.arcus.xyz
ARCUS_WS_URL=wss://api.testnet.arcus.xyz/v1/ws
# Market logos, {base}/markets/branding/{BASE_ASSET}.png -- the fallback when the
# metadata endpoint has no logo. Mainnet: https://branding.arcus.xyz
ARCUS_BRANDING_BASE_URL=https://branding.testnet.arcus.xyz

# Protective slippage bound on MARKET orders, basis points. Arcus rejects
# anything beyond 10% of mark, so keep this under 1000.
ARCUS_SLIPPAGE_BPS=900

# goodTilTime is mandatory on every order, including IOC, and must be at least
# one month in the future. Days of headroom to add.
ARCUS_GOOD_TIL_DAYS=60
ARCUS_REQUEST_TIMEOUT_MS=15000

# EIP-712 domain for POST /v1/withdraw (refunds, float recycling, close-out)
# and POST /v1/transfer (sweeps). Withdrawals land on the slot's internal
# wallet on Robinhood Chain testnet, where deposits happen too. Arcus changes
# testnet addresses on redeploys/resets -- check the withdraw docs' table.
# (The old names ARCUS_ROOT_CHAIN_ID / ARCUS_BRIDGE_VAULT are still read.)
ARCUS_CHAIN_ID=46630
ARCUS_BRIDGE_VAULT_ADDRESS=0x9a6d3499149fea853efe775a3577701539054eaf

# How withdrawals are authenticated:
#   wallet -- EIP-712 signature from the internal wallet's EVM key (default;
#             works with any API key).
#   apikey -- Ed25519 over the WithdrawV1 payload. Each slot's key then needs
#             the `withdraw` permission, which Arcus grants only through its
#             operator provisioning flow -- keys from the public createApiKey
#             are trade-only and get HTTP 403.
ARCUS_WITHDRAW_SIGNING=wallet

# One shared stream serves every slot (3 subscriptions each). Arcus allows 100
# per connection; a new connection opens past this cap.
ARCUS_STREAM_SUBS_PER_CONNECTION=90
# Every awaited fill / deposit credit / withdrawal also polls REST this often.
ARCUS_FALLBACK_POLL_MS=15000
# Waiting for a WITHDRAWAL event, then for the USDG to land on-chain.
WITHDRAWAL_APPLIED_TIMEOUT_MS=600000
USDG_ARRIVAL_TIMEOUT_MS=1200000

# Testnet USDG has an open mint: buy-ins fund Arcus and redeem payouts top up
# from freshly minted USDG. Set false on mainnet (the float must cover them).
USDG_MINTABLE=true

# Arcus's PaxosDepositProxy. Each internal wallet calls
# initiateDeposit(owner = itself, accountIndex, USDG, amount) on it -- Arcus
# requires owner == signer, which is why creators pay the internal wallet.
# Changes on every Arcus testnet reset: verify against the "Fund a testnet
# account" guide. Testnet at time of writing:
ARCUS_DEPOSIT_PROXY=0xb872366eef371d4afb7c6d4d2abd53c17292a34d

# --- Orchestration -----------------------------------------------------------
RESERVATION_TIMEOUT_MS=900000
DEPOSIT_POLL_INTERVAL_MS=5000
# Wait for Arcus to credit an initiateDeposit, and for a refund withdrawal to
# land back on the internal wallet on-chain.
ARCUS_CREDIT_TIMEOUT_MS=600000
ARCUS_WITHDRAWAL_TIMEOUT_MS=3600000
FILL_TIMEOUT_MS=60000
RECONCILE_INTERVAL_MS=180000
RECONCILE_DRIFT_TOLERANCE=1
INDEXER_CHECKPOINT_INTERVAL_MS=60000
REPORTER_INTERVAL_MS=60000
# Market table re-sync from Arcus (status, trading-hours window, prices). Runs
# regardless of the ENABLE_* flags -- GET /markets needs it.
MARKET_SYNC_INTERVAL_MS=60000
LIQUIDATOR_INTERVAL_MS=60000
# Resumes unfinished closes/settlements (runs with ENABLE_RECONCILER).
SETTLEMENT_INTERVAL_MS=60000

# Background workers. Off by default so `npm run dev` is a plain API server.
ENABLE_INDEXER=false
ENABLE_RECONCILER=false
ENABLE_REPORTER=false
ENABLE_LIQUIDATOR=false

# --- Auth (Privy) ------------------------------------------------------------
# From the Privy dashboard. Backend calls carry the user's Privy access token as
# `Authorization: Bearer ...`; these verify it and look up the user's wallet.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: the dashboard's JWT verification key. Unset, fetched over JWKS.
PRIVY_JWT_VERIFICATION_KEY=

# --- Gas faucet --------------------------------------------------------------
# Drips testnet ETH to a wallet when its user row is first CREATED, so email
# users' empty embedded wallets can sign. Its own wallet -- never the operator
# or liquidator key. Leave unset to disable the drip.
FAUCET_PRIVATE_KEY=
FAUCET_DRIP_ETH=0.002
# Skip the drip when the wallet already holds at least this much.
FAUCET_MIN_BALANCE_ETH=0.001

# --- Operator pool secrets ---------------------------------------------------
# Every `*_ref` column in the database names a secret, and secrets resolve to
# SECRET_<REF_UPPERCASED>. Swap src/config/secrets.ts for a KMS to change this.
#
# One internal Arcus wallet's EVM key. Needed at runtime, not just at API-key
# setup: the wallet receives creators' USDG, deposits it into its subaccounts,
# and sends refunds. Each internal wallet needs ~0.01 testnet ETH for gas; its
# one-time USDG.approve(depositProxy, MAX) is sent automatically on first use.
# SECRET_OPERATOR_A_EVM=0x...
#
# Its ten Arcus API keys -- one per accountIndex, since a key binds to exactly
# one (wallet, index) pair and cannot be reused across them. PKCS#8 PEM or a
# 32-byte hex seed:
# SECRET_OPERATOR_A_EVM_SLOT_0=...
# SECRET_OPERATOR_A_EVM_SLOT_1=...
# ... through SLOT_9
#
# Run `npm run slots:provision` with:
# ARCUS_OPERATOR_ADDRESS=0x...
# OPERATOR_SIGNER_REF=operator_a_evm
