# Matches the frontend's NEXT_PUBLIC_API_URL default (http://localhost:4000).
PORT=4000
LOG_LEVEL=info

# From your hosted Postgres (Neon/Supabase) -- see the README for setup steps
DATABASE_URL=

# --- Chain (Monad testnet) ---------------------------------------------------
# HTTPS only: every read and write is plain JSON-RPC (the indexer's live phase
# polls). A wss:// URL is refused at boot.
RPC_URL=https://testnet-rpc.monad.xyz
# Widest eth_getLogs range the RPC accepts (Monad public RPC: 100); wider queries are split.
RPC_LOGS_MAX_RANGE=100
CHAIN_ID=10143
# Perpl's collateral token (AUSD on testnet) -- the asset every Laxu contract is
# denominated in. From Contracts/deployments/monadTestnet.json. USDG_ADDRESS is
# still read as a deprecated alias when this is empty.
ASSET_ADDRESS=
# PerplReader: the venue reader PositionToken prices itself with (Spec 01).
PERPL_READER_ADDRESS=
POSITION_TOKEN_FACTORY_ADDRESS=
# Backfill start point for the indexer when no checkpoint row exists yet.
POSITION_TOKEN_FACTORY_DEPLOY_BLOCK=
# The open-position flow creates each position's LendingPool straight after
# minting its token, so this is required whenever orchestration runs.
LENDING_POOL_FACTORY_ADDRESS=
LENDING_POOL_FACTORY_DEPLOY_BLOCK=

# The one backend key for every Laxu contract write: createPosition,
# createPool, applyFunding, fulfil*, close. PositionTokenFactory passes its
# `deployer` through as each token's `operator`, so this key's address must be
# the Factory's `deployer`. Never committed.
OPERATOR_PRIVATE_KEY=
# LIQUIDATOR_PRIVATE_KEY holds NONE of the operator's roles -- liquidate() is
# permissionless, so it only ever needs an asset balance and pool approvals.
LIQUIDATOR_PRIVATE_KEY=

# --- Perpl -------------------------------------------------------------------
PERPL_API_URL=https://testnet.perpl.xyz/api
PERPL_WS_URL=wss://testnet.perpl.xyz
# Must equal CHAIN_ID.
PERPL_CHAIN_ID=10143
PERPL_EXCHANGE=0x1964C32f0bE608E7D29302AFF5E61268E72080cc
# Only for programmatic API-key enrollment in `npm run slots:provision` -- the
# Origin must be whitelisted by Perpl. Leave empty to create keys in the web UI.
PERPL_ORIGIN=
# Market-order slippage bound (`ms`), basis points. Clamped to each market's
# order_max_market_slippage_bps.
PERPL_SLIPPAGE_BPS=100
# How long to wait for an order's outcome on the trading WebSocket before the
# flow treats it as unknown and looks it up (it never resends blind).
PERPL_ORDER_TIMEOUT_MS=30000
PERPL_REQUEST_TIMEOUT_MS=15000
# Asset base units kept in every slot's Perpl account forever (never user
# money). Empty = the exchange's minimum account open amount, converted.
PERPL_SLOT_RESERVE=
# A heartbeat sequence gap forces a trading-socket reconnect; false = warn only.
PERPL_HEARTBEAT_GAP_RECONNECT=true
# Application ping (mt:1) period on the TRADING sockets, ms. Perpl's docs: about every
# 30 s; market-data sockets need none. Jittered +/- 2 s, started only after sign-in.
# 0 turns pings off (experiments only).
PERPL_WS_PING_MS=30000
# Testing: append every trading-WS frame and REST call (redacted) as JSONL here.
PERPL_RECORD_DIR=

# Builder code (Spec 06 Part 5). Perpl registers a builder id (1..255) by
# hand; slot keys must then be re-enrolled bound to it
# (npm run slots:enroll -- --all --builder-id <id> --max-fee <ceiling>).
# A fee of 0 is attribution only: no `bf` is sent. `bf` is never sent while
# the flag is off. Boot refuses an id outside 1..255 or fee > ceiling > 100.
PERPL_BUILDER_ENABLED=false
PERPL_BUILDER_ID=
# Ceiling signed at enrollment, per 100k (1 = 0.1 bps = 0.001%; max 100 = 0.1%).
PERPL_MAX_BUILDER_FEE_PER_100K=0
# Fee actually charged per order, per 100k (<= the ceiling).
PERPL_BUILDER_FEE_PER_100K=0

# --- Float -------------------------------------------------------------------
# Fronts buy-in funding and redeem payouts (replaces minting). Must hold the
# asset; refill it when /health shows it low. Defaults to OPERATOR_PRIVATE_KEY.
FLOAT_PRIVATE_KEY=
# true only if the test token has an open mint(to, amount) (Spec 00 script 02).
# Perpl's AUSD does not.
ASSET_MINTABLE=false

# --- Funding reporter --------------------------------------------------------
# applyFunding at least this often per position. Must stay well under the
# contract's FUNDING_MAX_AGE (2h): past it, isPriceFresh() turns false and
# borrowing pauses. Max 3600.
FUNDING_HEARTBEAT_SECONDS=1800
# Push sooner when the computed funding moves by at least
# max(FUNDING_PUSH_MIN, capital x FUNDING_PUSH_BPS / 1e4).
FUNDING_PUSH_MIN=100000    # asset base units (0.10 at 6dp)
FUNDING_PUSH_BPS=10        # of capital

# --- Orchestration -----------------------------------------------------------
RESERVATION_TIMEOUT_MS=900000
DEPOSIT_POLL_INTERVAL_MS=5000
RECONCILE_INTERVAL_MS=180000
# Asset (human decimal) drift tolerated between the ledger and the venue.
RECONCILE_DRIFT_TOLERANCE=1
INDEXER_CHECKPOINT_INTERVAL_MS=60000
REPORTER_INTERVAL_MS=60000
# Market table re-sync from Perpl (status, prices). Runs regardless of the
# ENABLE_* flags -- GET /markets needs it.
MARKET_SYNC_INTERVAL_MS=60000
LIQUIDATOR_INTERVAL_MS=60000
# Resumes unfinished closes/settlements (runs with ENABLE_RECONCILER).
SETTLEMENT_INTERVAL_MS=60000

# Background workers. Off by default so `npm run dev` is a plain API server.
ENABLE_INDEXER=false
ENABLE_RECONCILER=false
ENABLE_REPORTER=false
ENABLE_LIQUIDATOR=false

# --- Auth (Privy) ------------------------------------------------------------
# From the Privy dashboard. Backend calls carry the user's Privy access token as
# `Authorization: Bearer ...`; these verify it and look up the user's wallet.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: the dashboard's JWT verification key. Unset, fetched over JWKS.
PRIVY_JWT_VERIFICATION_KEY=

# --- Privy signers / server wallets (Spec 05) ----------------------------------
# Authorization key for acting on wallets: Dashboard -> Wallets -> Authorization keys
# -> Register key quorum instead (threshold 1, paste the PUBLIC key).
# PRIVY_SIGNER_ID is the quorum id (the signerId for addSigners, the owner_id of server wallets).
PRIVY_SIGNER_ID=
# The matching P-256 PRIVATE key. Accepted: the PEM from the quickstart's openssl
# command (SEC1 or PKCS8; on one line with newlines written as \n), or base64 PKCS8 DER,
# optionally prefixed wallet-auth: . The SDK itself wants base64 PKCS8 with no PEM
# header; scripts/privy/_lib.ts normalises. Never commit or paste it.
PRIVY_AUTH_PRIVATE_KEY=
# Spike only: an ERC-20 for the policy tests. Defaults to ASSET_ADDRESS (AUSD).
PRIVY_TEST_CONTRACT=

# --- Loan protection (Spec 05 Part 2) -------------------------------------------
# Auto-repay a user's loan from THEIR OWN Privy embedded wallet when its health
# factor falls to their trigger. Needs PRIVY_APP_ID/SECRET, PRIVY_SIGNER_ID and
# PRIVY_AUTH_PRIVATE_KEY above (the backend refuses to boot with this on and any
# missing). Run ONE backend with workers per database.
ENABLE_PROTECTION=false
# How often every enabled rule's health factor is read.
PROTECTION_INTERVAL_MS=5000
# Minimum seconds between two actions on one rule (after a repay or a failed
# attempt), and between two identical "could not act" notes.
PROTECTION_COOLDOWN_S=60
# Hard ceiling on one rule's max total spend, in the debt asset's base units
# (500000000 = 500 AUSD at 6 decimals).
PROTECTION_MAX_SPEND_CAP=500000000

# Hops of reverse proxy in front of the API, so req.ip is the real client (the
# faucet limits claims per IP). 1 behind one proxy (Render/Railway/Fly); 0 when
# clients connect directly -- otherwise X-Forwarded-For could pick their IP.
TRUST_PROXY=1

# --- Admin -------------------------------------------------------------------
# Shared secret for /admin/* (e.g. GET /admin/faucet), sent as `x-admin-token`.
# Leave unset to switch /admin off.
ADMIN_TOKEN=

# --- Test funds faucet (TESTNET ONLY) ----------------------------------------
# "Get test funds": sends the signed-in user FAUCET_ASSET_AMOUNT and tops their
# MON up to FAUCET_NATIVE_TARGET_WEI, paid entirely by the faucet wallet. Off
# unless FAUCET_ENABLED=true.
FAUCET_ENABLED=false
# Its own wallet -- never the operator, liquidator, float or slot keys.
# Required when enabled. Never committed.
FAUCET_PRIVATE_KEY=
# external           -> the faucet wallet calls requestFunds(user) on Perpl's
#                       AUSD faucet (FAUCET_EXTERNAL_ADDRESS); a revert (its
#                       60 s global cooldown) falls back to transfer. The
#                       default when ASSET_MINTABLE=false
# transfer           -> from the faucet wallet's own (pre-funded) balance
# direct             -> asset.mint(user, amount)            (needs ASSET_MINTABLE)
# mint_then_transfer -> asset.mint(amount), then transfer   (needs ASSET_MINTABLE)
# (FAUCET_USDG_MODE is still read as the old name.)
FAUCET_ASSET_MODE=external
# Perpl's testnet AUSD faucet (requestFunds(address), any caller, 60 s global cooldown).
FAUCET_EXTERNAL_ADDRESS=0xd236c18D274E54FAccC3dd9DDA4b27965a73ee6C
# What one external claim pays, shown to users (observed 10,000 AUSD).
FAUCET_EXTERNAL_AMOUNT=10000000000
# transfer (and the external fallback) amount. Base units, 6 decimals:
# 1000000000 = 1,000. (Old name FAUCET_USDG_AMOUNT.)
FAUCET_ASSET_AMOUNT=1000000000
# Tops the user's MON UP TO this (0.5 MON), it does not send this much.
# (Old name FAUCET_ETH_TARGET_WEI.)
FAUCET_NATIVE_TARGET_WEI=500000000000000000
FAUCET_COOLDOWN_HOURS=24
# Below this (2 MON) the faucet stops sending MON but still sends the asset.
# Boot and a 10-minute check warn once the balance is under 5x this.
# (Old name FAUCET_MIN_RESERVE_WEI.)
FAUCET_NATIVE_MIN_RESERVE_WEI=2000000000000000000

# --- Slot pool secrets (npm run slots:provision) -----------------------------
# One slot = one wallet = one Perpl account. Every `*_ref` column names a
# secret, which resolves to SECRET_<REF_UPPERCASED>; swap src/config/secrets.ts
# for a KMS to change this.
SLOT_COUNT=5
# Minimum MON per slot wallet before provisioning proceeds (0.5 MON).
SLOT_MIN_GAS_WEI=500000000000000000
#
# Per slot n = 1..SLOT_COUNT:
#   SECRET_SLOT_<n>_EVM   the slot wallet's EVM private key (holds MON for gas;
#                         receives creators' payments, funds its Perpl account)
#   PERPL_API_KEY_<n>     the wallet's Perpl API key token (X-API-Key), trade scope
#   SECRET_SLOT_<n>_API   that key's secret: Perpl's 64-hex "Secret" (with or
#                         without 0x) or a PKCS#8 PEM
# Leave PERPL_API_KEY_<n> / SECRET_SLOT_<n>_API empty and the script either
# enrolls a key (PERPL_ORIGIN set) or prints the manual steps.
#
# scripts/perpl/enrollSlotKey.ts (Spec 06 Part 4) enrolls a fresh key per slot
# and writes it to secrets/slot-keys.json (0600, gitignored), never to the
# console. It needs the Origin Perpl whitelisted for Laxu (a server must set it
# explicitly): the hosted frontend origin, e.g. https://laxu.example.
PERPL_ENROLL_ORIGIN=
SECRET_SLOT_1_EVM=
PERPL_API_KEY_1=
SECRET_SLOT_1_API=
SECRET_SLOT_2_EVM=
PERPL_API_KEY_2=
SECRET_SLOT_2_API=
# ... and so on through SLOT_COUNT.
