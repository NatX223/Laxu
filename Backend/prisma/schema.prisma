generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity -- wallet address is identity; backend calls authenticate with a
// verified Privy access token, which proves `privyUserId`. The wallet is read
// from Privy's own record of that user, never from a request body. `tag` is
// display only.
// ---------------------------------------------------------------------------

model User {
  walletAddress String        @id @map("wallet_address")
  privyUserId   String        @unique @map("privy_user_id")
  tag           String        @unique
  createdAt     DateTime      @default(now()) @map("created_at")
  positions     Position[]
  faucetClaims  FaucetClaim[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Test funds faucet (testnet only). A row is inserted as `pending` BEFORE
// anything is sent, so a double-click cannot pay twice; `sent` and `pending`
// rows count toward the per-user cooldown and the per-IP limit, `failed` ones
// do not. Keyed to the user by wallet address, which is User's primary key.
//
// Column names predate the move to Perpl: `usdg*` holds the asset (Perpl's
// collateral token), `eth*` the native gas token (MON).
// ---------------------------------------------------------------------------

model FaucetClaim {
  id            String   @id @default(cuid())
  walletAddress String   @map("wallet_address")
  ip            String?
  /// Asset base units, as strings.
  usdgAmount    String   @map("usdg_amount")
  /// Native wei; "0" when the wallet already held the target, or the send was skipped.
  ethAmountWei  String   @map("eth_amount_wei")
  usdgTxHash    String?  @map("usdg_tx_hash")
  ethTxHash     String?  @map("eth_tx_hash")
  /// Set when the native top-up was skipped because the faucet is under reserve.
  ethSkipped    Boolean  @default(false) @map("eth_skipped")
  status        String   @default("pending") // 'pending' | 'sent' | 'failed'
  error         String?
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [walletAddress], references: [walletAddress])

  @@index([walletAddress, createdAt])
  @@index([ip, createdAt])
  @@map("faucet_claims")
}

// ---------------------------------------------------------------------------
// Operator wallet pool -- on Perpl one wallet owns exactly one exchange
// account, so one OperatorWallet backs exactly one SubaccountSlot
// (`accountIndex` is always 0 and only keeps the unique index happy). The
// slot carries the Perpl account id and the wallet's Ed25519 API key.
// ---------------------------------------------------------------------------

model OperatorWallet {
  id           String           @id @default(cuid())
  address      String           @unique
  /// Name of the secret holding this wallet's EVM private key -- resolved
  /// through src/config/secrets.ts, never the raw key.
  evmSignerRef String           @map("evm_signer_ref")
  status       String           @default("active") // 'active' | 'retired'
  createdAt    DateTime         @default(now()) @map("created_at")
  slots        SubaccountSlot[]

  @@map("operator_wallets")
}

model SubaccountSlot {
  id               String         @id @default(cuid())
  operatorWalletId String         @map("operator_wallet_id")
  operatorWallet   OperatorWallet @relation(fields: [operatorWalletId], references: [id])
  /// Always 0 on Perpl (no subaccounts).
  accountIndex     Int            @map("account_index")

  /// Perpl's opaque `X-API-Key` token for this wallet's key (trade scope).
  apiKey       String @map("api_key")
  /// Secret name for the matching Ed25519 private key, not the key itself.
  apiSecretRef String @map("api_secret_ref")

  /// The wallet's Perpl exchange account id (uint256 as a decimal string).
  /// Null until `createAccount` has run; such a slot is never reserved.
  perplAccountId    String? @map("perpl_account_id")
  /// Highest request id (`rq`) handed out for this account, bigint as a
  /// string. Raised in the same write that saves the `rq` on its row.
  lastRequestId     String  @default("0") @map("last_request_id")
  /// `Account.fw` -- order forwarding ("one-click trading") is on.
  forwardingEnabled Boolean @default(false) @map("forwarding_enabled")
  /// Asset base units kept in the account forever (Perpl's minimum account
  /// open amount). Never user money: every free-balance calculation subtracts it.
  reserve           String  @default("0")

  status               String    @default("free") // 'free' | 'reserved' | 'allocated' | 'settling'
  reservedForUser      String?   @map("reserved_for_user")
  reservedAt           DateTime? @map("reserved_at")
  /// Set alongside reservedAt; the reclaim sweep frees a slot past it only while
  /// its open request is still awaiting payment. Cleared once payment arrives.
  reservationExpiresAt DateTime? @map("reservation_expires_at")

  positionId String?   @unique @map("position_id")
  position   Position? @relation(fields: [positionId], references: [id])
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([operatorWalletId, accountIndex])
  @@index([status])
  @@map("subaccount_slots")
}

// ---------------------------------------------------------------------------
// Positions
// ---------------------------------------------------------------------------

model Position {
  id String @id @default(cuid())

  /// Set at creation: a positions row only exists once the Factory has minted
  /// the token (PositionOpenRequest covers everything before that).
  positionTokenAddress String? @unique @map("position_token_address")
  /// The token's LendingPool. Null only while createPool keeps failing -- the
  /// reporter's minute tick retries it, and Borrow stays disabled until set.
  lendingPoolAddress   String? @map("lending_pool_address")

  userWalletAddress String @map("user_wallet_address")
  user              User   @relation(fields: [userWalletAddress], references: [walletAddress])

  subaccountSlot SubaccountSlot?

  /// `perpl:<accountId>:<requestId>` of the entry order -- the string the
  /// on-chain venuePositionId bytes32 hashes.
  venuePositionId  String? @map("venue_position_id")
  venueOrderId     String? @map("venue_order_id")
  /// The entry order's request id (`rq`), saved BEFORE placing so a restarted
  /// process can still recognise its own order.
  venueRequestId   String? @map("venue_request_id")
  /// Perpl's API position id (`pid`), used to match position stream events.
  venuePositionPid String? @map("venue_position_pid")

  /// bytes32 market key as stored on-chain; joins to Market.laxuMarket.
  market    String
  direction String // 'long' | 'short'
  leverage  Int

  /// Requested collateral, base-unit string in asset decimals.
  requestedAmount String  @map("requested_amount")
  /// What the venue credited, base units -- the token's initialDeposit.
  depositedAmount String? @map("deposited_amount")
  /// VWAP entry, 1e18 fixed point -- matches PositionToken.PRICE_SCALE.
  entryPrice      String? @map("entry_price")
  /// Base quantity x 1e6 (lib/units.ts) -- the scale PositionToken's
  /// `size * (mark - entry) / 1e18` needs to land in the asset. Mirrors the
  /// token: buy-ins and redeems resize it, and the indexer re-reads it after each.
  size            String?

  /// Mirrors of PositionToken state, refreshed by the indexer: `capital` and
  /// `fundingSettled` on every fulfil, `fundingAccrued` on every FundingUpdated,
  /// `markPrice` (the token's own currentMark()) on FundingUpdated/MarkSynced.
  /// Asset 6dp (signed for funding); mark at 1e18.
  capital        String?
  fundingSettled String  @default("0") @map("funding_settled")
  markPrice      String? @map("mark_price")
  fundingAccrued String  @default("0") @map("funding_accrued")

  /// Set by the creator's on-chain `list(nickname)`, mirrored by the indexer.
  /// Discovery shows listed positions only. The buy-in fee is the contract's
  /// 2% constant, so there is no fee column.
  listed   Boolean @default(false)
  nickname String  @default("")

  /// The creator's stop loss / take profit, set once at createPosition and
  /// never editable: the defaults for every holder who hasn't set their own.
  /// Human prices of the underlying ("1900"); null = none. `defaultsActive`
  /// mirrors the token, flipped off by `DefaultTriggersRetired`.
  defaultStopLoss   String? @map("default_stop_loss")
  defaultTakeProfit String? @map("default_take_profit")
  defaultsActive    Boolean @default(false) @map("defaults_active")

  /// 'open' | 'closed' (close() landed, funds still on the venue) | 'settled'
  /// (recovered asset in the token, holders can claim).
  status        String  @default("open")
  failureReason String? @map("failure_reason")

  /// Distinguishes a normal close from a venue-side liquidation -- on-chain
  /// `PositionClosed.wasLiquidated` carries the same bit, but there was
  /// otherwise no way to tell the two apart from the DB alone.
  liquidated Boolean @default(false)

  createdAt DateTime  @default(now()) @map("created_at")
  /// When the token minted and the position went `open`. The charts' entry
  /// marker and NAV baseline sit here.
  openedAt  DateTime? @map("opened_at")
  closedAt  DateTime? @map("closed_at")

  ledgerEntries  LedgerEntry[]
  reports        PositionReport[]
  holdings       Holding[]
  flows          Flow[]
  stats          PositionStats?
  settlement     Settlement?
  holderTriggers HolderTrigger[]

  @@index([status])
  @@index([userWalletAddress])
  @@index([liquidated])
  @@index([listed])
  @@map("positions")
}

// ---------------------------------------------------------------------------
// One open-position attempt, start to finish. The frontend polls `status` for
// its progress screen.
//
//   awaiting_payment -> payment_received -> deposited -> order_filled -> minted
//                    or -> refunded / failed
//
// The creator pays the slot wallet with a plain asset transfer; that wallet
// then calls `depositCollateral` on Perpl's Exchange itself (only an account's
// own wallet can fund it). Everything the flow learns along the way is written
// here first, so a restart resumes from the row rather than repeating a step
// that moves money.
// ---------------------------------------------------------------------------

model PositionOpenRequest {
  id                String  @id @default(cuid())
  userWalletAddress String  @map("user_wallet_address") // the creator
  slotId            String  @map("slot_id") // the slot (Perpl account) used
  marketId          String  @map("market_id") // Market.laxuMarket
  direction         String // 'long' | 'short'
  leverage          Int
  amount            String // asset base units
  /// The creator's default SL/TP, human prices; null = none. Passed to
  /// createPosition once the fill is known.
  stopLoss          String? @map("stop_loss")
  takeProfit        String? @map("take_profit")
  paymentTxHash     String? @unique @map("payment_tx_hash") // creator -> slot wallet transfer
  depositTxHash     String? @map("deposit_tx_hash") // slot wallet -> Exchange.depositCollateral
  creditedAmount    String? @map("credited_amount") // what the venue credited, base units
  status            String  @default("awaiting_payment")

  /// Written before the order is sent (with the `lb` it is sent with), so a
  /// restart can look the order up instead of placing a second one.
  venueRequestId     String? @map("venue_request_id")
  venueLastExecBlock String? @map("venue_last_exec_block")
  /// The on-chain position size6 / entry18 just before that order was sent:
  /// once the chain is past `lb`, a changed size means it filled (by the
  /// delta), an unchanged one that it was never placed.
  venueSizeBefore    String? @map("venue_size_before")
  venueEntryBefore   String? @map("venue_entry_before")
  /// Entry orders sent so far (a not-placed order is retried, 3 at most).
  venueAttempts      Int     @default(0) @map("venue_attempts")
  venueOrderId       String? @map("venue_order_id")
  /// The actual position, human-readable decimals, read from the Exchange after
  /// the fill -- the same source createPosition's venue check reads.
  entryPrice         String? @map("entry_price")
  filledSize         String? @map("filled_size")

  positionTokenAddress String? @map("position_token_address")
  lendingPoolAddress   String? @map("lending_pool_address")

  /// Refund progress: the `withdrawCollateral` back to the slot wallet (only
  /// when the deposit already happened), then the on-chain transfer home.
  refundWithdrawTxHash String? @map("refund_withdraw_tx_hash")
  refundTxHash         String? @map("refund_tx_hash")

  error     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([slotId])
  @@map("position_open_requests")
}

// ---------------------------------------------------------------------------
// Position reports -- full mark price / funding history, not just the latest.
// `Position` only ever holds the current state; this is what the NAV chart
// replays. Written by the funding reporter every tick (deduped per minute) and
// on every `FundingUpdated` from the indexer.
// ---------------------------------------------------------------------------

model PositionReport {
  id         String   @id @default(cuid())
  positionId String   @map("position_id")
  position   Position @relation(fields: [positionId], references: [id])

  /// String, same reasoning as ledger_entries.amount -- avoid precision drift.
  markPrice String @map("mark_price")
  funding   String

  /// The contract's own totalAssets()/totalSupply() at the report's block,
  /// read rather than recomputed so the NAV chart can never drift from the
  /// contract's accounting. Base-unit strings.
  totalAssets String  @map("total_assets")
  totalSupply String  @map("total_supply")
  /// The single point written from `PositionClosed` -- totalAssets is then
  /// `finalNavValue`, and the NAV series ends here.
  isFinal     Boolean @default(false) @map("is_final")
  /// On the final point only: true from `PositionClosed` (the formula
  /// estimate) until `Settled` rewrites it with the asset actually recovered.
  provisional Boolean @default(false)

  timestamp DateTime
  createdAt DateTime @default(now()) @map("created_at")

  /// Doubles as the dedupe guard: applyFunding() on-chain requires strictly
  /// increasing timestamps per position, so a re-delivered or re-backfilled
  /// FundingUpdated just hits this constraint and is silently skipped.
  @@unique([positionId, timestamp])
  @@map("position_reports")
}

// ---------------------------------------------------------------------------
// Ledger -- venueStatus is what makes crash recovery possible. Always write
// `pending` BEFORE calling the venue; flip to `confirmed` only after the venue
// confirms, so a restart mid-flight knows where it left off instead of guessing.
// ---------------------------------------------------------------------------

model LedgerEntry {
  id         String   @id @default(cuid())
  positionId String   @map("position_id")
  position   Position @relation(fields: [positionId], references: [id])

  type   String // 'deposit' | 'margin_add' | 'margin_remove' | 'trigger_exit' | 'close' | 'cancel'
  /// String, not float -- avoids precision drift on money. Asset base units.
  amount String

  /// 'pending' | 'confirmed' | 'reversed' | 'cancelled'. `cancelled`: the user
  /// took the request back on-chain (cancelDepositRequest/cancelRedeemRequest)
  /// before it was fulfilled, and any venue-side move was undone.
  venueStatus String @default("pending") @map("venue_status")

  /// On-chain request correlation for the margin flows. `requestId` is always
  /// 0 on PositionToken, so it cannot tell requests apart -- the emitting log's
  /// (txHash, logIndex) is what dedupes request, close and cancel events.
  onchainRequestId   String?   @map("onchain_request_id")
  txHash             String?   @map("tx_hash")
  logIndex           Int?      @map("log_index")
  controller         String?
  /// Set once the matching fulfill* call lands, so the recovery sweep can tell
  /// a finished entry from one stranded mid-flight.
  onchainFulfilledAt DateTime? @map("onchain_fulfilled_at")

  /// The venue order id of this entry's last order, once known.
  venueOrderId       String?  @map("venue_order_id")
  /// The request event's own amount: assets (6dp) for a buy-in, shares for a
  /// redeem. `amount` above is the asset value.
  requestAmount      String?  @map("request_amount")
  /// The venue order's `rq` / `lb`, saved before it is sent, so a restart can
  /// look the order up instead of sending a second one.
  venueRequestId     String?  @map("venue_request_id")
  venueLastExecBlock String?  @map("venue_last_exec_block")
  /// On-chain position size6 / entry18 just before that order was sent (see
  /// PositionOpenRequest.venueSizeBefore).
  venueSizeBefore    String?  @map("venue_size_before")
  venueEntryBefore   String?  @map("venue_entry_before")
  /// Buy-in / redeem venue leg, saved as it happens so a restart or the
  /// reconciler can finish the on-chain fulfil with the real fill. `filledSize`
  /// is size6, `fillPrice` 1e18; both "0" for a margin-only buy-in or a redeem
  /// below the minimum order size.
  filledSize         String?  @map("filled_size")
  fillPrice          String?  @map("fill_price")
  /// trigger_exit only: the batch's holders, their shares and closed-size
  /// slices, with a `done` flag per executeTrigger, so a restart finishes the
  /// on-chain exits with the same split the venue order was sized from.
  batch              Json?
  note               String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([txHash, logIndex])
  @@index([positionId, type])
  @@index([venueStatus])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Markets -- synced from Perpl `GET /v1/pub/context` every minute
// (marketSync.ts). Not cosmetic: orders carry prices and sizes as integers
// scaled by priceDecimals / sizeDecimals, and Perpl has two ids per market --
// `venueMarketId` for the API and `perpetualId` on-chain. Never mix them up.
// No row here means no trading. Rows are never deleted -- a market that
// vanishes from Perpl goes OFFLINE, because positions reference it.
// ---------------------------------------------------------------------------

model Market {
  /// bytes32 of the base asset, right-padded ("ETH" -> 0x455448…00). This is
  /// what PositionToken stores as `market` and renders back into the token's
  /// name, so it must stay readable ASCII -- never a hash. Never changes.
  id            String  @id @map("laxu_market")
  /// Perpl API market id (`Market.id`): `mkt` in orders, ticker keys.
  venueMarketId Int     @unique @map("venue_market_id")
  /// Perpl on-chain perpetual id (`Market.perpetual_id`): Exchange.getPosition
  /// and PerplReader.
  perpetualId   Int     @unique @map("perpetual_id")
  displaySymbol String  @unique @map("display_symbol") // "ETH-USD"
  baseAsset     String  @unique @map("base_asset") // "ETH"
  fullAssetName String  @map("full_asset_name") // "Ethereum"
  /// Drives the filter tabs. Always CRYPTO on Perpl.
  assetClass    String  @map("asset_class") // 'CRYPTO' | 'EQUITIES' | 'COMMODITIES' | 'INDICES'
  status        String // 'ONLINE' | 'OFFLINE'
  /// Perpl's market icon; null when it has none -- the frontend draws a letter
  /// avatar.
  logoUrl       String? @map("logo_url")

  /// Leverage inputs -- see maxLeverage() in services/markets.ts.
  initialMarginFraction         String  @map("initial_margin_fraction")
  /// Trading-hours fields. Perpl trades 24/7, so these are always the
  /// in-hours fraction / false / null; kept so the schema still fits a venue
  /// with trading hours.
  offHoursInitialMarginFraction String  @map("off_hours_initial_margin_fraction")
  isOutsideRth                  Boolean @default(false) @map("is_outside_rth")
  regularTradingHours           Json?   @map("regular_trading_hours")

  /// Perpl's integer scales: price = p / 10^priceDecimals (= on-chain
  /// priceDecimals), size = s / 10^sizeDecimals (= on-chain lotDecimals).
  priceDecimals    Int    @map("price_decimals")
  sizeDecimals     Int    @map("size_decimals")
  /// `lb` ceiling offset: an order's last execution block <= head + this.
  orderTtlBlocks   Int    @map("order_ttl_blocks")
  /// `order_max_market_slippage_bps` -- the cap on a market order's `ms`.
  maxSlippageBps   Int    @map("max_slippage_bps")
  /// Base-tier taker fee in micros (1000 = 0.1%).
  takerFeeMicros   Int    @map("taker_fee_micros")
  /// `config.min_posting_amount`, Perpl's raw API Amount string.
  minPostingAmount String @map("min_posting_amount")

  /// Order sizing. Decimal strings, same rule as the ledger. tickSize and
  /// stepSize are 10^-priceDecimals and 10^-sizeDecimals.
  tickSize         String @map("tick_size")
  stepSize         String @map("step_size")
  minOrderSize     String @map("min_order_size")
  maxOrderSize     String @map("max_order_size")
  minOrderNotional String @map("min_order_notional")

  /// The venue's liquidation line as a fraction of notional. Drives "At Risk":
  /// equity / notional < 1.5 x this.
  maintenanceMarginFraction String @default("0") @map("maintenance_margin_fraction")

  /// Display only -- up to a minute stale. The open flow reads Perpl fresh.
  markPrice      String @map("mark_price")
  priceChange24h String @map("price_change_24h")

  syncedAt DateTime @updatedAt @map("synced_at")

  @@index([status])
  @@map("markets")
}

// ---------------------------------------------------------------------------
// Lending-side liquidation bot -- every LendingPool discovered off
// LendingPoolFactory.PoolCreated, and every wallet seen borrowing against one.
// Mirrors the PositionToken discovery pattern: chain events are the source of
// truth, these tables just bound the health-check loop's watch list.
// ---------------------------------------------------------------------------

model LendingPool {
  id                   String     @id @default(cuid())
  poolAddress          String     @unique @map("pool_address")
  positionTokenAddress String     @map("position_token_address")
  createdAt            DateTime   @default(now()) @map("created_at")
  borrowers            Borrower[]

  @@map("lending_pools")
}

model Borrower {
  id               String      @id @default(cuid())
  lendingPoolId    String      @map("lending_pool_id")
  lendingPool      LendingPool @relation(fields: [lendingPoolId], references: [id])
  address          String
  /// Re-read from the pool on every lending event (collateralBalance /
  /// currentDebt). Shares 6dp; debt asset 6dp.
  collateralShares String      @default("0") @map("collateral_shares")
  debt             String      @default("0")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at")

  @@unique([lendingPoolId, address])
  @@map("borrowers")
}

// ---------------------------------------------------------------------------
// Metrics -- discovery, position and portfolio pages. Holding / Flow are
// written by the indexer from chain events; PositionStats is recomputed every
// minute straight after the reporter tick (services/positionStats.ts).
// ---------------------------------------------------------------------------

/// Token balances, re-read from balanceOf on every Transfer (idempotent).
model Holding {
  positionId String   @map("position_id")
  position   Position @relation(fields: [positionId], references: [id])
  address    String
  balance    String // shares, 6 decimals
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([positionId, address])
  @@index([address])
  @@map("holdings")
}

/// Capital in and out of a position, at the NAV it happened at.
model Flow {
  id          String   @id @default(cuid())
  positionId  String   @map("position_id")
  position    Position @relation(fields: [positionId], references: [id])
  type        String // open | buy_in | top_up | redeem | trigger_exit | claim
  /// trigger_exit only: 'stop_loss' | 'take_profit'.
  trigger     String?
  address     String
  assets      String // asset 6dp (net of fee for buy-ins)
  feeAssets   String   @default("0") @map("fee_assets")
  shares      String
  navPerShare String   @map("nav_per_share") // 1e18
  txHash      String   @map("tx_hash")
  logIndex    Int      @map("log_index")
  timestamp   DateTime

  @@unique([txHash, logIndex])
  @@index([positionId, timestamp])
  @@index([address])
  @@map("flows")
}

/// A holder's own SL/TP override, mirrored from `TriggersSet`. No row = the
/// holder uses the position's defaults (while `defaultsActive`); a row with
/// both levels null = explicitly none. A personal trigger that fires is
/// deleted (`TriggerExecuted` with `usedDefault = false`).
model HolderTrigger {
  positionId String   @map("position_id")
  position   Position @relation(fields: [positionId], references: [id])
  holder     String
  stopLoss   String?  @map("stop_loss") // human price; null = none
  takeProfit String?  @map("take_profit")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([positionId, holder])
  @@map("holder_triggers")
}

/// The 2% buy-in fee, collected at requestDeposit -- before the buy-in's Flow
/// row exists. Held here until the matching DepositFulfilled folds it into that
/// Flow's `feeAssets`; voided when the request is cancelled instead.
model BuyInFee {
  id          String   @id @default(cuid())
  positionId  String   @map("position_id")
  controller  String
  amount      String // asset 6dp
  txHash      String   @map("tx_hash")
  logIndex    Int      @map("log_index")
  blockNumber BigInt   @map("block_number")
  flowId      String?  @map("flow_id")
  voided      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([txHash, logIndex])
  @@index([positionId, controller])
  @@map("buy_in_fees")
}

/// Close -> withdraw -> settle -> push claims, one row per closing position.
/// Every step records what it did here before moving on, and each checks the
/// chain before acting, so a restart resumes rather than repeating a step that
/// moves money (services/settlement.ts).
///
///   closing -> withdrawing -> settling -> settled
model Settlement {
  positionId        String    @id @map("position_id")
  position          Position  @relation(fields: [positionId], references: [id])
  trigger           String // 'creator_close' | 'liquidation'
  /// The final cumulative funding (asset 6dp) pushed once the venue leg was
  /// flat, so a restart calls close() with the real value. `finalMarkPrice`
  /// is the token's currentMark() at that moment, informational only --
  /// close() reads the venue mark itself.
  finalMarkPrice    String?   @map("final_mark_price")
  finalFunding      String?   @map("final_funding")
  closeTxHash       String?   @map("close_tx_hash")
  /// Set just before `withdrawCollateral` is sent: a restart that finds this
  /// without `withdrawTxHash` reads the account balance instead of sending a
  /// second withdrawal.
  withdrawStartedAt DateTime? @map("withdraw_started_at")
  withdrawTxHash    String?   @map("withdraw_tx_hash")
  recoveredAssets   String?   @map("recovered_assets") // asset 6dp
  fundTxHash        String?   @map("fund_tx_hash") // slot wallet -> token top-up
  settleTxHash      String?   @map("settle_tx_hash")
  recoverTxHash     String?   @map("recover_tx_hash") // token.recoverExcess
  claimsPushedAt    DateTime? @map("claims_pushed_at")
  status            String    @default("closing")
  error             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("settlements")
}

/// One row per position, refreshed every minute.
model PositionStats {
  positionId        String   @id @map("position_id")
  position          Position @relation(fields: [positionId], references: [id])
  navPerShare       String   @map("nav_per_share") // 1e18
  totalAssets       String   @map("total_assets") // asset 6dp
  totalSupply       String   @map("total_supply")
  pnlBps            Int      @map("pnl_bps") // (nav - 1) in bps
  markPrice         String   @map("mark_price") // 1e18
  fundingNet        String   @map("funding_net") // fundingAccrued - fundingSettled, asset 6dp
  effectiveLeverage String   @map("effective_leverage") // size x mark / totalAssets, decimal
  holderCount       Int      @map("holder_count")
  buyInVolume       String   @map("buy_in_volume") // all-time, gross (assets + fee), asset 6dp
  buyInVolume24h    String   @map("buy_in_volume_24h")
  buyerCount24h     Int      @map("buyer_count_24h")
  isAtRisk          Boolean  @map("is_at_risk")
  isCollateralized  Boolean  @map("is_collateralized")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("position_stats")
}

// ---------------------------------------------------------------------------
// Indexer checkpoint -- durable block position, singleton row (id always 1).
// Backfill (getLogs) resumes from here on boot; live delivery is a
// watchContractEvent subscription, not polling, so this only bounds a
// restart's backfill window rather than being required for correctness.
// ---------------------------------------------------------------------------

model IndexerCheckpoint {
  id                 Int      @id @default(1)
  lastProcessedBlock BigInt   @map("last_processed_block")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("indexer_checkpoint")
}
