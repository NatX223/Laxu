{
  "name": "laxu-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc --outDir .test-build --rootDir src && node --test --test-name-pattern=. .test-build/**/*.test.js && node -e \"require('fs').rmSync('.test-build',{recursive:true,force:true})\"",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "ts-node-dev --transpile-only --respawn=false prisma/seed.ts",
    "slots:provision": "ts-node-dev --transpile-only --respawn=false scripts/provisionSlots.ts",
    "smoke": "ts-node-dev --transpile-only --respawn=false scripts/smoke.ts"
  },
  "prisma": {
    "seed": "ts-node-dev --transpile-only --respawn=false prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "@privy-io/node": "^0.35.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "viem": "^2.21.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "prisma": "^5.19.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
