# Copy to .env. Used by hardhat.config.js and scripts/deploy.js. Never committed.

# Robinhood Chain testnet RPC (chain id 46630)
RPC_URL=

# Deployer / owner of every contract (roles, vault registrar wiring)
ADMIN_PRIVATE_KEY=

# The backend's operator address. PositionTokenFactory passes it through as
# each token's arcusOperator; must match the backend's OPERATOR_PRIVATE_KEY.
OPERATOR_ADDRESS=

# Arcus testnet USDG (6 decimals)
USDG_ADDRESS=0x293b337712d4312776a3a2d292f44410e7873bad

# Per-pool debt ceiling at the vault, USDG base units (6 decimals)
DEFAULT_DEBT_CEILING=
# Optional: USDG (base units) the deployer seeds into the LendingVault
SEED_VAULT_AMOUNT=
