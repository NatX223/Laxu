# Copy to .env. Used by hardhat.config.js and scripts/deploy.js. Never committed.

# ---- Monad testnet (chain id 10143) -- the Perpl deployment ----
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Deployer / owner of every contract. MONAD_ADMIN_PRIVATE_KEY is accepted as a fallback name.
DEPLOYER_PRIVATE_KEY=
# The backend's contract-writing wallet: PositionTokenFactory's `deployer` and every token's
# `operator`. On monadTestnet, MONAD_OPERATOR_ADDRESS wins over OPERATOR_ADDRESS.
MONAD_OPERATOR_ADDRESS=
# Perpl testnet Exchange. The asset is read from its getExchangeInfo().collateralToken -- never set it.
PERPL_EXCHANGE=0x1964C32f0bE608E7D29302AFF5E61268E72080cc
# Markets come from deployments/perplMarkets.testnet.json (npx hardhat run scripts/perplMarkets.js):
# every open market, or only these. perpId there is Perpl's perpetual_id, not the API market id.
# MARKET_SYMBOLS=ETH,BTC,SOL,MON
# Optional: Perpl API to snapshot markets from (default https://testnet.perpl.xyz/api/v1/pub/context)
PERPL_API_URL=
# Optional: AUSD (whole units, or "all") the deployer deposits into the LendingVault -- used by
# scripts/seed-vault.js and the end of deploy.js. Fund the deployer from Agora's faucet first.
SEED_VAULT_AMOUNT=
# Optional: per-pool debt ceiling in asset base units (default 100,000 of the asset)
DEFAULT_DEBT_CEILING=
# Optional: Monadscan verification (Etherscan v2 key). Sourcify/MonadVision needs no key.
ETHERSCAN_API_KEY=
# Optional: run test/fork/*.js against a Monad testnet fork
MONAD_FORK_RPC=

# ---- Legacy network entry in hardhat.config.js, not used by this build ----
RPC_URL=
ADMIN_PRIVATE_KEY=
OPERATOR_ADDRESS=
