# Copy to .env.local. Everything here is public (NEXT_PUBLIC_*), inlined into
# the browser bundle at build time -- never put a secret in this file.

# Privy dashboard -> App ID (the App Secret belongs to the backend only)
NEXT_PUBLIC_PRIVY_APP_ID=

# Robinhood Chain testnet
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_RPC_WS_URL=
NEXT_PUBLIC_EXPLORER_URL=

# USDG token, for approvals ahead of buy-ins, repays and lending
NEXT_PUBLIC_USDG_ADDRESS=

# Laxu backend base URL (its default PORT is 3000, which `next dev` also takes --
# run one of them on another port)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Arcus public market data (charts). No key needed.
NEXT_PUBLIC_ARCUS_API_URL=https://api.testnet.arcus.xyz
NEXT_PUBLIC_ARCUS_WS_URL=wss://api.testnet.arcus.xyz/v1/ws
