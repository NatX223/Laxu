# Copy to .env.local. Everything here is public (NEXT_PUBLIC_*), inlined into
# the browser bundle at build time -- never put a secret in this file.

# Privy dashboard -> App ID (the App Secret belongs to the backend only)
NEXT_PUBLIC_PRIVY_APP_ID=

# Robinhood Chain testnet (chain id 46630)
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_RPC_WS_URL=
NEXT_PUBLIC_EXPLORER_URL=

# Arcus testnet USDG (6 decimals). Must match the backend's USDG_ADDRESS: the
# trade ticket refuses to pay a reservation that names any other token.
NEXT_PUBLIC_USDG_ADDRESS=0x293b337712d4312776a3a2d292f44410e7873bad

# A public Robinhood Chain testnet ETH faucet. Linked from "Get test funds" when
# Laxu's own faucet is too low to send gas. Optional.
NEXT_PUBLIC_ETH_FAUCET_URL=

# Laxu backend base URL. The backend listens on PORT=4000 by default, clear of
# `next dev` on 3000.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Arcus public market data (charts). No key needed.
NEXT_PUBLIC_ARCUS_API_URL=https://api.testnet.arcus.xyz
NEXT_PUBLIC_ARCUS_WS_URL=wss://api.testnet.arcus.xyz/v1/ws
# Market logos -- only read when the backend is unreachable and the market list
# falls back to Arcus directly. Mainnet: https://branding.arcus.xyz
NEXT_PUBLIC_ARCUS_BRANDING_URL=https://branding.testnet.arcus.xyz
