# Copy to .env.local. Everything here is public (NEXT_PUBLIC_*), inlined into
# the browser bundle at build time -- never put a secret in this file.

# Privy dashboard -> App ID (the App Secret belongs to the backend only)
NEXT_PUBLIC_PRIVY_APP_ID=

# Monad testnet (chain id 10143). The RPC must be HTTPS.
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_RPC_WS_URL=wss://testnet-rpc.monad.xyz
# Block explorer behind every tx / address link. Defaults to MonadVision.
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadvision.com

# The collateral token Perpl settles in (AUSD on testnet). Its symbol and
# decimals are read from the contract, never hard-coded. Must match the
# backend's asset: the trade ticket refuses to pay a reservation that names
# any other token.
NEXT_PUBLIC_ASSET_ADDRESS=

# A public testnet-MON faucet. Linked from "Get test funds" when Laxu's own
# faucet is too low to send gas. Optional.
NEXT_PUBLIC_MON_FAUCET_URL=https://faucet.testnet.monad.xyz

# Laxu backend base URL. The backend listens on PORT=4000 by default, clear of
# `next dev` on 3000.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Perpl public market data (candles, book, ticker, market list). No key needed.
#
# Perpl allows cross-origin browser reads from its own origin only: REST has no
# CORS headers for other origins and the market-data WebSocket handshake is
# refused (403) for them. So the browser reads through the Laxu backend's
# cached proxy, `GET {API_URL}/market-data/v1/...`, which mirrors Perpl's paths.
# That is the default when this is unset. Set it to the Perpl API URL below
# only for a deployment Perpl has allow-listed.
NEXT_PUBLIC_MARKET_DATA_BASE=
# Upstream Perpl REST / WebSocket hosts (the backend proxy talks to these).
NEXT_PUBLIC_PERPL_API_URL=https://testnet.perpl.xyz/api
NEXT_PUBLIC_PERPL_WS_URL=wss://testnet.perpl.xyz
# Perpl's trading app, for "view on Perpl" links.
NEXT_PUBLIC_PERPL_APP_URL=https://testnet.perpl.xyz
